---
import styles from './Footer.module.css'

const year = new Date().getFullYear()

// Site-wide links. Add the site privacy policy (#49) and company profile
// (#52) here once those pages exist.
const groups = [
  {
    id: 'footer-service',
    title: 'サービス',
    links: [
      { href: '/service/', label: 'サービス一覧' },
      { href: '/service/f-label/', label: 'Fラベル', ctaId: 'footer_flabel' },
      { href: '/tools/', label: '無料ツール', ctaId: 'footer_tools' },
    ],
  },
  {
    id: 'footer-content',
    title: '記事・お問い合わせ',
    links: [
      { href: '/articles/', label: '記事一覧' },
      { href: '/contact/', label: 'お問い合わせ', ctaId: 'footer_contact' },
    ],
  },
  {
    id: 'footer-legal',
    title: 'Fラベルの規約',
    links: [
      { href: '/service/f-label/terms/', label: '利用規約' },
      { href: '/service/f-label/privacy/', label: 'プライバシーポリシー' },
    ],
  },
]
---

<footer class={styles.footer}>
  <div class={`container ${styles.inner}`}>
    <div class={styles.top}>
      <nav class={styles.nav} aria-label="フッター">
        {groups.map((group) => (
          <div class={styles.group}>
            <p id={group.id} class={styles.groupTitle}>
              {group.title}
            </p>
            <ul class={styles.linkList} aria-labelledby={group.id}>
              {group.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class={styles.link}
                    data-track-event={link.ctaId ? 'mix_cta_click' : undefined}
                    data-track-surface={link.ctaId ? 'footer' : undefined}
                    data-track-cta-id={link.ctaId}
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
      <div class={styles.social}>
        <div class={styles.socialLinks}>
          <a
            href="https://x.com/Mix_Juice_io"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="X (Twitter)"
            aria-describedby="new-tab-note"
            class={styles.socialIcon}
          >
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <div class={styles.bottom}>
      <p>&copy; {year} Mix-Juice. All rights reserved.</p>
    </div>
  </div>
</footer>
