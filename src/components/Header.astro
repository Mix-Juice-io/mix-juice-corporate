---
import styles from './Header.module.css'

const navItems = [
  { to: '/', label: 'Home' },
  { to: '/service/', label: 'Service' },
  { to: '/articles/', label: 'Articles' },
  { to: '/contact/', label: 'Contact' },
]

const pathname = Astro.url.pathname
const isActive = (to: string) =>
  to === '/' ? pathname === '/' : pathname.startsWith(to)
---

<header class={styles.header} data-header>
  <div class={`container ${styles.inner}`}>
    <a href="/" class={styles.logo}>
      <img
        src="/logo.webp"
        alt="Mix-Juice"
        width="1024"
        height="226"
        decoding="async"
        class={styles.logoImg}
      />
    </a>

    <button
      type="button"
      class={styles.menuBtn}
      data-menu-btn
      aria-label="メニュー"
      aria-controls="site-nav"
      aria-expanded="false"
    >
      <svg
        class="icon-menu"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <line x1="4" x2="20" y1="12" y2="12"></line>
        <line x1="4" x2="20" y1="6" y2="6"></line>
        <line x1="4" x2="20" y1="18" y2="18"></line>
      </svg>
      <svg
        class="icon-close"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M18 6 6 18"></path>
        <path d="m6 6 12 12"></path>
      </svg>
    </button>

    <nav id="site-nav" class={styles.nav} data-nav>
      {navItems.map((item) => (
        <a
          href={item.to}
          class={`${styles.navLink} ${isActive(item.to) ? styles.navLinkActive : ''}`}
          aria-current={isActive(item.to) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<style>
  .icon-close {
    display: none;
  }
  [aria-expanded='true'] .icon-menu {
    display: none;
  }
  [aria-expanded='true'] .icon-close {
    display: block;
  }
</style>

<script define:vars={{ navOpenClass: styles.navOpen }}>
  const header = document.querySelector('[data-header]')
  const btn = document.querySelector('[data-menu-btn]')
  const nav = document.querySelector('[data-nav]')
  if (header && btn && nav) {
    const isOpen = () => btn.getAttribute('aria-expanded') === 'true'
    const setOpen = (open) => {
      btn.setAttribute('aria-expanded', String(open))
      nav.classList.toggle(navOpenClass, open)
    }

    btn.addEventListener('click', () => {
      const open = !isOpen()
      setOpen(open)
      if (open) nav.querySelector('a')?.focus()
    })

    // Escape closes the menu and returns focus to the toggle button.
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen()) {
        setOpen(false)
        btn.focus()
      }
    })

    // Close when keyboard focus leaves the header, so Tab never lands on
    // page content hidden behind the open menu.
    header.addEventListener('focusout', (e) => {
      if (isOpen() && e.relatedTarget && !header.contains(e.relatedTarget)) {
        setOpen(false)
      }
    })

    // Reset when the viewport grows past the mobile breakpoint.
    matchMedia('(min-width: 769px)').addEventListener('change', (e) => {
      if (e.matches) setOpen(false)
    })
  }
</script>
