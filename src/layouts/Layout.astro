---
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import '../index.css'

interface Props {
  title: string
  description?: string
  ogType?: 'website' | 'article'
  ogImage?: string
  noindex?: boolean
}

const {
  title,
  description = 'Mix-Juice | Shopifyアプリ開発 - スモールビジネスのためのTech Studio',
  ogType = 'website',
  ogImage = '/logo.png',
  noindex = false,
} = Astro.props

const canonical = new URL(Astro.url.pathname, Astro.site).href
const ogImageUrl = new URL(ogImage, Astro.site).href
const GA_ID = import.meta.env.VITE_GA_MEASUREMENT_ID
// gtag is loaded only when the page is served from this host. Keep in sync
// with isProductionHost() in src/lib/analytics.ts.
const GA_HOST = Astro.site?.hostname

const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': new URL('/#organization', Astro.site).href,
  name: 'Mix-Juice',
  url: Astro.site?.href,
  logo: new URL('/logo.png', Astro.site).href,
}

const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': new URL('/#website', Astro.site).href,
  name: 'Mix-Juice',
  url: Astro.site?.href,
  inLanguage: 'ja',
  publisher: { '@id': organizationJsonLd['@id'] },
}
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <link rel="canonical" href={canonical} />
    )}

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content="Mix-Juice" />
    <meta property="og:locale" content="ja_JP" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(organizationJsonLd)}
    />
    {Astro.url.pathname === '/' && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(websiteJsonLd)}
      />
    )}
    <slot name="head" />

    {GA_ID && GA_HOST && (
      <script
        is:inline
        set:html={`
            if (location.hostname === ${JSON.stringify(GA_HOST)}) {
              window.dataLayer = window.dataLayer || [];
              window.gtag = function () { dataLayer.push(arguments); };
              gtag('js', new Date());
              gtag('config', ${JSON.stringify(GA_ID)});
              var s = document.createElement('script');
              s.async = true;
              s.src = 'https://www.googletagmanager.com/gtag/js?id=' + ${JSON.stringify(GA_ID)};
              document.head.appendChild(s);
            }
          `}
      />
    )}
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />

    <script>
      import '../scripts/click-tracking'
      import '../scripts/article-tracking'
      import { trackEvent } from '../lib/analytics'

      const path = window.location.pathname.replace(/\/$/, '') || '/'
      if (path === '/service/f-label') {
        trackEvent('mix_lp_view', { lp_variant: 'flabel_v1' })
      }
    </script>

    <script>
      // Scroll-reveal: progressively enhance any `.reveal` element. Elements
      // already in view are left alone; only those starting below the
      // viewport are marked pending (hidden) and faded in when scrolled to.
      // State lives in a data attribute, and React islands are skipped, so
      // hydrated components never see their markup changed beforehand.
      const reduceMotion = matchMedia(
        '(prefers-reduced-motion: reduce)',
      ).matches
      if ('IntersectionObserver' in window && !reduceMotion) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return
              const el = entry.target as HTMLElement
              delete el.dataset.reveal
              observer.unobserve(el)
            })
          },
          { threshold: 0.1 },
        )
        document.querySelectorAll<HTMLElement>('.reveal').forEach((el) => {
          if (el.closest('astro-island')) return
          if (el.getBoundingClientRect().top < window.innerHeight) return
          el.dataset.reveal = 'pending'
          observer.observe(el)
        })
      }
    </script>
  </body>
</html>
