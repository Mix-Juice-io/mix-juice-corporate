# Cloudflare Pages response headers. Applies to static assets only; Pages
# Functions must set their own headers in code.
# https://developers.cloudflare.com/pages/configuration/headers/

# CSP enforced since 2026-11-08 after report-only showed no violations on the
# main pages (GA4, Turnstile). A new third-party script, frame, font or
# endpoint must be added here first. HSTS starts at one day (no subdomains);
# raise max-age once it has run without trouble.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://static.cloudflareinsights.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://www.googletagmanager.com https://*.google-analytics.com; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com https://www.google.com https://cloudflareinsights.com; frame-src https://challenges.cloudflare.com; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'
  Strict-Transport-Security: max-age=86400

# Hashed build output never changes under the same name.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Article feed (src/pages/articles/rss.xml.ts). Static files get their type from
# the extension, which would be application/xml.
/articles/rss.xml
  Content-Type: application/rss+xml; charset=utf-8

# Keep pages.dev aliases (production alias and preview branches) out of search.
https://mix-juice-corporate.pages.dev/*
  X-Robots-Tag: noindex
https://:branch.mix-juice-corporate.pages.dev/*
  X-Robots-Tag: noindex
