# Google Analytics 4 Measurement ID.
# Set this in the hosting provider's environment variables for production builds.
# When unset, analytics is disabled and no tracking script is loaded.
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Microsoft Clarity project ID (session recording and heatmaps).
# When unset, Clarity is not loaded.
VITE_CLARITY_PROJECT_ID=
