---
import Layout from '../../layouts/Layout.astro'
import { getPublishedArticles, formatDate } from '../../lib/articles'
import { groupByTopic, topicName } from '../../lib/article-topics'
import { FLABEL_APP_URL } from '../../lib/urls'
import '../../styles/articles.css'

const articles = await getPublishedArticles()
const groups = groupByTopic(articles, (a) => a.data.topic)
const newest = articles.slice(0, 3)

// The short line under each card title: the part of the title after "｜",
// or the title itself when there is no subtitle.
function splitTitle(title: string): { main: string; sub: string | null } {
  const i = title.indexOf('｜')
  return i < 0
    ? { main: title, sub: null }
    : { main: title.slice(0, i), sub: title.slice(i + 1) }
}

// Free tools shown in the band. The label maker leads because it is the tool
// most readers of these articles end up needing.
const tools = [
  {
    href: '/tools/food-label-maker/',
    ctaId: 'articles_tool_label_maker',
    title: '食品表示ラベル作成',
    description: '配合の重量から一括表示を作り、ラベル用紙に印刷',
    main: true,
  },
  {
    href: '/tools/nutrition-labeling-check/',
    ctaId: 'articles_tool_nutrition_check',
    title: '栄養成分表示、うちは必要？',
    description: '売り方ごとに要否を判定',
    main: false,
  },
  {
    href: '/tools/origin-labeling-check/',
    ctaId: 'articles_tool_origin_check',
    title: '原料原産地表示のチェック',
    description: '対象の原材料と書き方',
    main: false,
  },
  {
    href: '/tools/expiry-date-record/',
    ctaId: 'articles_tool_expiry_record',
    title: '賞味期限・消費期限の決め方',
    description: '試験結果から計算して記録',
    main: false,
  },
]
---

<Layout
  title="食品を作って売る人のための食品表示ガイド | Mix-Juice"
  description="お菓子や惣菜を作って店頭やネットで売る人に向けて、一括表示・原材料・アレルギー・添加物などの表示の書き方と、営業の許可や規格書など売る前の準備を、法令と消費者庁の資料をもとに説明します。"
>
  <div class="art-page">
    <section class="art-hero">
      <div class="art-hero-bg">
        <div class="art-blob1"></div>
        <div class="art-blob2"></div>
      </div>
      <div class="container">
        <p class="art-label">ARTICLES</p>
        <h1 class="art-title">食品を作って売る人のための食品表示ガイド</h1>
        <p class="art-desc">
          お菓子や惣菜を作って、店頭やネットで売る人に向けて、表示の書き方と売る前の準備を、法令と消費者庁の資料をもとに説明します。
        </p>
        <nav class="art-jump" aria-label="テーマへ移動">
          {groups.map(({ topic }) => (
            <a class="art-jump-link" href={`#topic-${topic.id}`}>
              {topic.name}
            </a>
          ))}
          <a class="art-jump-link" href="#tools">
            無料ツール
          </a>
        </nav>
      </div>
    </section>

    <section class="art-content">
      <div class="container art-index">
        <section class="art-tools" id="tools" aria-labelledby="tools-title">
          <div class="art-tools-head">
            <h2 class="art-tools-title" id="tools-title">
              無料ツール
            </h2>
            <a
              class="art-tools-all"
              href="/tools/"
              data-track-event="mix_cta_click"
              data-track-surface="articles_index_tool"
              data-track-cta-id="articles_tools_index"
              data-track-link-text="ツール一覧へ"
            >
              ツール一覧へ →
            </a>
          </div>
          <ul class="art-tools-list">
            {tools.map((tool) => (
              <li>
                <a
                  class:list={['art-tool', { 'art-tool-main': tool.main }]}
                  href={tool.href}
                  data-track-event="mix_cta_click"
                  data-track-surface="articles_index_tool"
                  data-track-cta-id={tool.ctaId}
                  data-track-link-text={tool.title}
                >
                  <span class="art-tool-title">{tool.title}</span>
                  <span class="art-tool-desc">{tool.description}</span>
                  {tool.main && (
                    <span class="art-tool-more">ツールを使う →</span>
                  )}
                </a>
              </li>
            ))}
          </ul>
        </section>

        {groups.map(({ topic, items }) => (
          <section
            class="art-topic"
            id={`topic-${topic.id}`}
            aria-labelledby={`topic-${topic.id}-title`}
          >
            <div class="art-topic-head">
              <h2 class="art-topic-title" id={`topic-${topic.id}-title`}>
                {topic.name}
              </h2>
              <p class="art-topic-lead">{topic.lead}</p>
            </div>
            <ul class="art-topic-list">
              {items.map((article) => {
                const { main, sub } = splitTitle(article.data.title)
                const updated = article.data.updatedDate
                const date = updated ?? article.data.publishDate
                return (
                  <li>
                    <a class="art-item" href={`/articles/${article.id}/`}>
                      <span class="art-item-title">{main}</span>
                      {sub && <span class="art-item-sub">{sub}</span>}
                      <span class="art-item-date">
                        {updated && <span class="art-item-updated">更新</span>}
                        <time datetime={date.toISOString()}>
                          {formatDate(date)}
                        </time>
                      </span>
                    </a>
                  </li>
                )
              })}
            </ul>
          </section>
        ))}

        <aside
          class="art-flabel art-index-flabel"
          aria-labelledby="index-flabel-title"
        >
          <img
            class="art-flabel-icon"
            src="/f-label.webp"
            alt="Fラベル"
            width="1200"
            height="1200"
            loading="lazy"
            decoding="async"
          />
          <div class="art-flabel-body">
            <p class="art-flabel-badge">Shopify App</p>
            <h2 id="index-flabel-title" class="art-flabel-title">
              Shopifyで食品を売っているなら「Fラベル」
            </h2>
            <p class="art-flabel-desc">
              原材料・添加物・アレルゲン・栄養成分をまとめて管理し、Shopifyの商品ページに食品表示を掲載できるアプリです。商品が増えても、表示の書き直しを減らせます。
            </p>
            <div class="art-flabel-cta">
              <a
                class="btn btn-primary"
                href={FLABEL_APP_URL}
                target="_blank"
                rel="noopener noreferrer"
                aria-describedby="new-tab-note"
                data-track-event="mix_outbound_shopify_app,mix_cta_click"
                data-track-surface="articles_index_flabel"
                data-track-cta-id="articles_flabel_install"
              >
                Shopifyアプリストアで見る
              </a>
              <a
                class="btn btn-outline"
                href="/service/f-label/"
                data-track-event="mix_cta_click"
                data-track-surface="articles_index_flabel"
                data-track-cta-id="articles_flabel_detail"
              >
                Fラベルの詳細を見る
              </a>
            </div>
          </div>
        </aside>

        <section class="art-newest" aria-labelledby="newest-title">
          <h2 class="art-newest-title" id="newest-title">
            新着
          </h2>
          <ol class="art-newest-list">
            {newest.map((article) => (
              <li>
                <time datetime={article.data.publishDate.toISOString()}>
                  {formatDate(article.data.publishDate)}
                </time>
                <span class="art-newest-topic">
                  {topicName(article.data.topic)}
                </span>
                <a href={`/articles/${article.id}/`}>
                  {splitTitle(article.data.title).main}
                </a>
              </li>
            ))}
          </ol>
          <p class="art-newest-feed">
            新しい記事は
            <a href="/articles/rss.xml">RSS</a>
            でも受け取れます。
          </p>
        </section>
      </div>
    </section>
  </div>
</Layout>
