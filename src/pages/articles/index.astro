---
import Layout from '../../layouts/Layout.astro'
import { getPublishedArticles, formatDate } from '../../lib/articles'
import '../../styles/articles.css'

const articles = await getPublishedArticles()

// The guide that should rank for "shopify 食品". Search Console showed those
// queries landing on this list page instead, so link it prominently here.
const FEATURED_ARTICLE_ID = 'shopify-food-sales-complete-guide'
const featured = articles.find((a) => a.id === FEATURED_ARTICLE_ID)
if (!featured) {
  throw new Error(`Featured article "${FEATURED_ARTICLE_ID}" is not published`)
}
---

<Layout
  title="食品EC・食品表示・Shopifyの実務ガイド | Mix-Juice"
  description="Mix-JuiceによるEC・Shopify・食品表示まわりの実務に役立つ記事をお届けします。"
>
  <div class="art-page">
    <section class="art-hero">
      <div class="art-hero-bg">
        <div class="art-blob1"></div>
        <div class="art-blob2"></div>
      </div>
      <div class="container">
        <p class="art-label">ARTICLES</p>
        <h1 class="art-title">記事一覧</h1>
        <p class="art-desc">
          EC運営やShopify、食品表示まわりの実務に役立つ情報をお届けします。
        </p>
      </div>
    </section>

    <section class="art-content">
      <div class="container">
        <a
          class="art-card art-featured reveal"
          href={`/articles/${featured.id}/`}
        >
          <p class="art-featured-label">Shopifyで食品を販売するなら</p>
          <h2 class="art-card-title">{featured.data.title}</h2>
          <p class="art-card-desc">{featured.data.description}</p>
          <span class="art-card-more">ガイドを読む →</span>
        </a>
        <div class="art-grid">
          {articles.map((article) => (
            <a class="art-card reveal" href={`/articles/${article.id}/`}>
              <div class="art-card-meta">
                {article.data.category && (
                  <span class="art-card-cat">{article.data.category}</span>
                )}
                <time datetime={article.data.publishDate.toISOString()}>
                  {formatDate(article.data.publishDate)}
                </time>
              </div>
              <h2 class="art-card-title">{article.data.title}</h2>
              <p class="art-card-desc">{article.data.description}</p>
              <span class="art-card-more">記事を読む →</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  </div>
</Layout>
