# Google Analytics 4 Measurement ID.
# Set this in the hosting provider's environment variables for production builds.
# When unset, analytics is disabled and no tracking script is loaded.
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Public Turnstile site key, available in the browser at build time.
PUBLIC_TURNSTILE_SITE_KEY=

# Pages Functions bindings (runtime, server only). Set these in Cloudflare Pages
# separately for Preview / Production; use ignored .dev.vars for local development.
# Verify the sender domain in Resend. CONTACT_FROM / CONTACT_TO are bare addresses.
# Never prefix these secrets with PUBLIC_ or VITE_.
RESEND_API_KEY=
TURNSTILE_SECRET_KEY=
CONTACT_FROM=
CONTACT_TO=
